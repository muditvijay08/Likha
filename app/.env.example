# Supabase project (Mumbai). Public values only; the service key never goes in the app.
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key>
# Google Maps JavaScript API key with Places (New) enabled, restricted to likha.in and localhost.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
# OneSignal web push app id (optional until launch)
NEXT_PUBLIC_ONESIGNAL_APP_ID=
# 1 = run fully in the browser with sample data, no backend (for design review and tests)
NEXT_PUBLIC_DEMO=0
