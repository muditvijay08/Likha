# Copy to deploy/.env and fill in (0-secrets.sh does the copy). Never commit it (it is in .gitignore).
# Put values with spaces in quotes, e.g. OWNER_NAME="Mudit Dudhoria".
# Provider keys (AI, Razorpay, MSG91, Maps, OneSignal) do NOT go here: set them in Admin > Keys after step 5.

# ---- Supabase (project in Mumbai, ap-south-1) ----
SUPABASE_PROJECT_REF=            # e.g. abcdefghijklmnop (Project settings > General)
SUPABASE_ACCESS_TOKEN=           # supabase.com > Account > Access tokens (for the CLI)
SUPABASE_DB_URL=''               # in single quotes: Project settings > Database > Connection string (URI, session pooler), with the password
SUPABASE_ANON_KEY=               # Project settings > API > anon public key

# ---- Your addresses ----
LIKHA_SITE=https://likha.in
LIKHA_ADMIN_SITE=https://admin.likha.in
KUNDLI_DOMAIN=kundli.likha.in    # DNS A record -> your Mumbai server

# ---- Secrets (0-secrets.sh fills these with random values if empty; keep a copy in your password manager) ----
LIKHA_INTERNAL_SECRET=           # scheduled jobs -> functions (32+ characters)
LIKHA_HASH_SALT=                 # NEVER change after launch
LIKHA_KUNDLI_KEY=                # functions -> kundli server

# ---- From Supabase after you create the Send SMS hook (Authentication > Hooks) ----
SEND_SMS_HOOK_SECRET=            # looks like v1,whsec_...

# ---- Vercel (member app and admin) ----
VERCEL_TOKEN=                    # vercel.com > Account settings > Tokens
VERCEL_SCOPE=                    # your Vercel team slug (leave empty for a personal account)

# ---- First owner (step 5) ----
OWNER_EMAIL=
OWNER_NAME=
